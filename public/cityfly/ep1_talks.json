    "t_start": [
      {
        "who": "hakase",
        "face": "normal",
        "text": "まずは、海に向かいましょう！　あのおかしな建物を間近で確認するわよ。"
      },
      {
        "who": "hakase",
        "face": "normal",
        "text": "私たちはシティタワー内で指揮を執るわ！　ここは緊急の為に頑丈に作られているからね！"
      },
      {
        "who": "nei",
        "face": "worry",
        "text": "気持ち悪い形した建物・・・！　なんだか怪獣みたい・・・。"
      },
      {
        "who": "hakase",
        "face": "worry",
        "text": "デッドアトモスの仕業に違いないわね。　急に現れたっていうのもおかしい。"
      },
      {
        "who": "hakase",
        "face": "normal",
        "text": "十分に注意して！"
      },
      {
        "who": "nei",
        "face": "normal",
        "text": "はーい・・・。"
      }
    ],
    "t_wave1": [
      {
