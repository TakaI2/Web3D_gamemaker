{
  "format": "cityfly-events",
  "version": 1,
  "events": [
    {
      "id": "start",
      "when": {
        "param": "playTime",
        "op": ">=",
        "value": 2
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_start"
        }
      ]
    },
    {
      "id": "wave1",
      "when": {
        "param": "playTime",
        "op": ">=",
        "value": 30
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_wave1"
        },
        {
          "type": "spawn",
          "enemy": "jet"
        }
      ]
    },
    {
      "id": "jets",
      "when": {
        "on": "jetsAppear"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_jets"
        }
      ]
    },
    {
      "id": "rescue",
      "when": {
        "param": "since:jetsAppear",
        "op": ">=",
        "value": 30
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_rescue"
        },
        {
          "type": "safezone"
        },
        {
          "type": "flag",
          "flag": "rescueTold"
        }
      ]
    },
    {
      "id": "jetspec",
      "when": {
        "param": "talkIdle",
        "op": ">=",
        "value": 30,
        "flag": "rescueTold"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_jetspec"
        }
      ]
    },
    {
      "id": "walkerStart",
      "when": {
        "param": "attrition",
        "op": ">=",
        "value": 40
      },
      "do": [
        {
          "type": "spawn",
          "enemy": "walker"
        }
      ]
    },
    {
      "id": "carrierPre",
      "when": {
        "param": "attrition",
        "op": ">=",
        "value": 70
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_carrier_pre"
        }
      ]
    },
    {
      "id": "carrierMove",
      "when": {
        "param": "attrition",
        "op": ">=",
        "value": 75
      },
      "do": [
        {
          "type": "advance",
          "enemy": "spider"
        }
      ]
    },
    {
      "id": "city1",
      "when": {
        "param": "cityDamage",
        "op": ">=",
        "value": 1,
        "notFlag": "fed"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_city1"
        }
      ]
    },
    {
      "id": "city3",
      "when": {
        "param": "cityDamage",
        "op": ">=",
        "value": 3,
        "notFlag": "fed"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_city3"
        }
      ]
    },
    {
      "id": "city5",
      "when": {
        "param": "cityDamage",
        "op": ">=",
        "value": 5,
        "notFlag": "fed"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_city5"
        }
      ]
    },
    {
      "id": "badRoute10",
      "when": {
        "param": "cityDamage",
        "op": ">=",
        "value": 10
      },
      "do": [
        {
          "type": "flag",
          "flag": "badRoute"
        }
      ]
    },
    {
      "id": "grabShip",
      "when": {
        "on": "grabShip"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_grab_ship"
        }
      ]
    },
    {
      "id": "grabTower",
      "when": {
        "on": "grabTower"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_grab_tower"
        }
      ]
    },
    {
      "id": "feed",
      "when": {
        "on": "feedHuman"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_feed"
        },
        {
          "type": "flag",
          "flag": "fed"
        },
        {
          "type": "flag",
          "flag": "badRoute"
        }
      ]
    },
    {
      "id": "carrier",
      "when": {
        "on": "carrierWake"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_carrier"
        }
      ]
    },
    {
      "id": "missile",
      "when": {
        "on": "carrierMissile"
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_missile"
        }
      ]
    },
    {
      "id": "walker2",
      "when": {
        "param": "walkerLaunched",
        "op": ">=",
        "value": 2
      },
      "do": [
        {
          "type": "talk",
          "talk": "t_walker2"
        }
      ]
    },
    {
      "id": "spiderDownGood",
      "when": {
        "kill": "spider",
        "notFlag": "badRoute"
      },
      "do": [
        {
          "type": "flag",
          "flag": "warEnd"
        },
        {
          "type": "flow",
          "port": "win",
          "delay": 5
        }
      ]
    },
    {
      "id": "spiderDownBad",
      "when": {
        "kill": "spider",
        "flag": "badRoute"
      },
      "do": [
        {
          "type": "flag",
          "flag": "warEnd"
        },
        {
          "type": "flow",
          "port": "bad",
          "delay": 5
        }
      ]
    }
  ]
}
